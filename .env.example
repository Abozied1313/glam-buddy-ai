# Client-side (public, safe to ship in the browser bundle)
VITE_SUPABASE_PROJECT_ID="your-project-ref"
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-publishable-anon-key"

# Server-side only — NEVER add these to this file or to any VITE_ variable.
# They are configured in Project Settings -> Secrets and are read by Edge Functions:
#   LOVABLE_API_KEY        (AI gateway, used for the Gemini analysis call)
#   REPLICATE_API_TOKEN    (image generation)
#   SUPABASE_SERVICE_ROLE_KEY (managed automatically)
